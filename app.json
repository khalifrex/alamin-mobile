{
  "expo": {
    "name": "ShirtCraft",
    "slug": "shirtcraft",
    "scheme": "shirtcraft",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shirtcraft.app",
      "infoPlist": {
        "NSAppTransportSecurity": { "NSAllowsArbitraryLoads": true, "NSAllowsLocalNetworking": true }
      }
    },
    "android": {
      "package": "com.shirtcraft.app",
      "adaptiveIcon": {
        "backgroundColor": "#1A1A2E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      ["expo-build-properties", { "android": { "usesCleartextTraffic": true } }],
      ["expo-image-picker", { "photosPermission": "ShirtCraft needs access to your photos so you can print your artwork on a shirt.", "cameraPermission": false, "microphonePermission": false }]
    ]
  }
}
